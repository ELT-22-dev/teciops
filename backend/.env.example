# Copie este arquivo para ".env" e preencha os valores antes de rodar a aplicacao.

# Porta em que a API vai escutar
PORT=4000

# Ambiente: development | production | test
NODE_ENV=development

# String de conexao do PostgreSQL
# Local (docker-compose):
DATABASE_URL="postgresql://teciops:teciops@localhost:5432/teciops?schema=public"

# Segredos JWT - GERE VALORES ALEATORIOS FORTES EM PRODUCAO (ex: openssl rand -hex 32)
JWT_ACCESS_SECRET="troque-este-valor-em-producao-acesso"
JWT_REFRESH_SECRET="troque-este-valor-em-producao-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Origem(ns) permitidas para CORS, separadas por virgula. Use * apenas em desenvolvimento.
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Provedor de emissao de NF-e: "mock" (simulado, padrao) ou "focus_nfe" / "plugnotas" (ver README)
FISCAL_PROVIDER="mock"
FISCAL_PROVIDER_API_KEY=""
FISCAL_PROVIDER_BASE_URL=""

# Chave da API Anthropic (opcional) - se definida, o Agente OPS usa Claude para
# responder perguntas livres alem das respostas baseadas em regras/dados do banco.
ANTHROPIC_API_KEY=""

# Limite de requisicoes por IP (janela de 15 min)
RATE_LIMIT_MAX=300
