generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Empresa / usuarios
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  cnpj      String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  customers    Customer[]
  suppliers    Supplier[]
  articles     Article[]
  rolls        Roll[]
  importLots   ImportLot[]
  orders       Order[]
  titles       FinancialTitle[]
  fiscalNotes  FiscalNote[]
  stockMoves   StockMovement[]
  conferences  Conference[]
  agentThreads AgentMessage[]

  @@map("companies")
}

enum Role {
  OWNER
  MANAGER
  SELLER
  WAREHOUSE
  FINANCE
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(SELLER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ordersAsSeller Order[]         @relation("OrderSeller")
  stockMoves     StockMovement[]
  conferences    Conference[]
  refreshTokens  RefreshToken[]

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Cadastros
// ---------------------------------------------------------------------------

model Customer {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  cnpj          String?
  phone         String?
  neighborhood  String?
  address       String?
  creditLimit   Decimal  @default(0) @db.Decimal(12, 2)
  active        Boolean  @default(true)
  customerSince DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders          Order[]
  financialTitles FinancialTitle[]

  @@index([companyId])
  @@index([companyId, name])
  @@map("customers")
}

model Supplier {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  country      String?
  leadTimeDays Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  importLots ImportLot[]

  @@index([companyId])
  @@map("suppliers")
}

model Article {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  composition   String?
  widthMeters   Decimal? @db.Decimal(6, 2)
  costPerMeter  Decimal  @default(0) @db.Decimal(10, 2)
  salePerMeter  Decimal  @default(0) @db.Decimal(10, 2)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rolls      Roll[]
  orderItems OrderItem[]

  @@index([companyId])
  @@index([companyId, name])
  @@map("articles")
}

// ---------------------------------------------------------------------------
// Estoque de rolos
// ---------------------------------------------------------------------------

enum RollStatus {
  WHOLE     // inteiro
  RESERVED  // reservado
  REMNANT   // retalho
  CRITICAL  // critico (saldo muito baixo)
}

model Roll {
  id             String     @id @default(cuid())
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code           String // ex: R-4412, unico por empresa
  articleId      String
  article        Article    @relation(fields: [articleId], references: [id])
  color          String
  initialMeters  Decimal    @db.Decimal(10, 2)
  balanceMeters  Decimal    @db.Decimal(10, 2)
  weightKg       Decimal?   @db.Decimal(10, 2)
  warehouse      String // ex: DEP-A
  location       String? // ex: P12
  status         RollStatus @default(WHOLE)
  landedCost     Decimal?   @db.Decimal(10, 2)
  importLotId    String?
  importLot      ImportLot? @relation(fields: [importLotId], references: [id])
  criticalBelowMeters Decimal @default(5) @db.Decimal(10, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  orderItems OrderItem[]
  movements  StockMovement[]
  conferences Conference[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, articleId])
  @@map("rolls")
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

model StockMovement {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rollId    String
  roll      Roll              @relation(fields: [rollId], references: [id], onDelete: Cascade)
  type      StockMovementType
  meters    Decimal           @db.Decimal(10, 2)
  reason    String? // ex: "PED-2418", "Entrada de lote LT-2618", "Ajuste de conferencia"
  orderId   String?
  order     Order?            @relation(fields: [orderId], references: [id])
  userId    String?
  user      User?             @relation(fields: [userId], references: [id])
  createdAt DateTime          @default(now())

  @@index([companyId, rollId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Importacao
// ---------------------------------------------------------------------------

enum ImportLotStatus {
  BOOKED      // reservado / a embarcar
  SHIPPED     // embarcado
  IN_TRANSIT  // em transito
  CLEARING    // desembaraco
  ARRIVED     // chegou / recebido
}

model ImportLot {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code         String // ex: LT-2618
  supplierId   String
  supplier     Supplier        @relation(fields: [supplierId], references: [id])
  articlesDesc String // descricao livre dos artigos do lote
  country      String?
  container    String?
  meters       Decimal         @db.Decimal(10, 2)
  fobUsd       Decimal         @db.Decimal(12, 2)
  exchangeRate Decimal         @db.Decimal(8, 4)
  costPerMeter Decimal         @db.Decimal(10, 2)
  eta          DateTime
  status       ImportLotStatus @default(BOOKED)
  receivedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  rolls Roll[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("import_lots")
}

// ---------------------------------------------------------------------------
// Pedidos / vendas de balcao
// ---------------------------------------------------------------------------

enum OrderChannel {
  COUNTER   // balcao / corte imediato
  WHOLESALE // pedido atacado
}

enum OrderStage {
  QUOTE          // orcamento
  AWAITING_CUT   // aguardando corte
  CUT            // cortado
  INVOICED       // faturado (NF-e emitida)
  DELIVERED      // entregue
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  CARD
  BOLETO
  TERM // fiado / prazo (caderneta ou titulo a prazo)
}

model Order {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code         String // ex: PED-2418
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id])
  sellerId     String
  seller       User          @relation("OrderSeller", fields: [sellerId], references: [id])
  channel      OrderChannel  @default(COUNTER)
  stage        OrderStage    @default(QUOTE)
  paymentMethod PaymentMethod @default(CASH)
  totalMeters  Decimal       @default(0) @db.Decimal(10, 2)
  discount     Decimal       @default(0) @db.Decimal(10, 2)
  totalValue   Decimal       @default(0) @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  items           OrderItem[]
  stockMovements  StockMovement[]
  financialTitles FinancialTitle[]
  fiscalNotes     FiscalNote[]

  @@unique([companyId, code])
  @@index([companyId, stage])
  @@index([companyId, customerId])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  articleId    String
  article      Article  @relation(fields: [articleId], references: [id])
  rollId       String?
  roll         Roll?    @relation(fields: [rollId], references: [id])
  color        String
  meters       Decimal  @db.Decimal(10, 2)
  unitPrice    Decimal  @db.Decimal(10, 2)
  totalPrice   Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Financeiro
// ---------------------------------------------------------------------------

enum TitleStatus {
  OPEN
  PAID
  OVERDUE
  CANCELLED
}

model FinancialTitle {
  id            String        @id @default(cuid())
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String // ex: TIT-1188
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  orderId       String?
  order         Order?        @relation(fields: [orderId], references: [id])
  value         Decimal       @db.Decimal(12, 2)
  dueDate       DateTime
  paidAt        DateTime?
  paymentMethod PaymentMethod @default(BOLETO)
  status        TitleStatus   @default(OPEN)
  isCaderneta   Boolean       @default(false) // fiado de balcao sem boleto
  lastChargedAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@map("financial_titles")
}

// ---------------------------------------------------------------------------
// Fiscal (NF-e)
// ---------------------------------------------------------------------------

enum FiscalNoteStatus {
  PENDING
  AUTHORIZED
  REJECTED
  CANCELLED
}

model FiscalNote {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  number         String // numero da NF-e
  orderId        String
  order          Order            @relation(fields: [orderId], references: [id])
  cfop           String
  value          Decimal          @db.Decimal(12, 2)
  icms           Decimal          @default(0) @db.Decimal(12, 2)
  status         FiscalNoteStatus @default(PENDING)
  sefazProtocol  String?
  accessKey      String?
  rejectionReason String?
  issuedAt       DateTime         @default(now())
  cancelledAt    DateTime?

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("fiscal_notes")
}

// ---------------------------------------------------------------------------
// App do deposito (conferencia)
// ---------------------------------------------------------------------------

enum ConferenceStatus {
  PENDING
  CONFIRMED
  DIVERGENT
}

model Conference {
  id             String            @id @default(cuid())
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rollId         String
  roll           Roll              @relation(fields: [rollId], references: [id])
  userId         String?
  user           User?             @relation(fields: [userId], references: [id])
  systemMeters   Decimal           @db.Decimal(10, 2)
  countedMeters  Decimal           @db.Decimal(10, 2)
  difference     Decimal           @db.Decimal(10, 2)
  status         ConferenceStatus  @default(PENDING)
  createdAt      DateTime          @default(now())
  resolvedAt     DateTime?

  @@index([companyId, status])
  @@map("conferences")
}

// ---------------------------------------------------------------------------
// Agente OPS - historico de conversas (auditoria/contexto)
// ---------------------------------------------------------------------------

model AgentMessage {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  role      String // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("agent_messages")
}
